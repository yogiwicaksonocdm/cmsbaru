# Password untuk login dashboard admin (/admin)
ADMIN_PASSWORD=ganti-dengan-password-admin

# (Opsional) Secret HMAC untuk token admin. Default: ADMIN_PASSWORD
# ADMIN_AUTH_SECRET=

# Kredensial Firebase Admin (Service Account) untuk Firestore
FIREBASE_PROJECT_ID=project-id-anda
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@project-id-anda.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n"

# (Opsional) Port server lokal, default 3000
# PORT=3000
